{
  "openapi": "3.0.1",
  "info": {
    "title": "SitePulse API",
    "version": "0.1.0",
    "description": "Prototype API for SitePulse flows"
  },
  "servers": [
    { "url": "http://localhost:3000" }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authenticated" }
        }
      }
    },
    "/api/v1/sites/{siteId}/attendance": {
      "get": { "summary": "List attendance", "parameters": [{ "name": "siteId", "in": "path", "required": true, "schema": { "type": "string" } }] },
      "post": { "summary": "Create attendance batch", "parameters": [{ "name": "siteId", "in": "path", "required": true, "schema": { "type": "string" } }] }
    },
    "/api/v1/sites/{siteId}/tasks": {
      "get": { "summary": "List tasks", "parameters": [{ "name": "siteId", "in": "path", "required": true, "schema": { "type": "string" } }] },
      "post": { "summary": "Create task", "parameters": [{ "name": "siteId", "in": "path", "required": true, "schema": { "type": "string" } }] }
    },
    "/api/v1/sites/{siteId}/dashboard/weekly-wages": {
      "get": { "summary": "Weekly wage totals", "parameters": [{ "name": "siteId", "in": "path", "required": true, "schema": { "type": "string" } }] }
    },
    "/api/v1/sites/{siteId}/savings": {
      "get": { "summary": "Savings snapshots", "parameters": [{ "name": "siteId", "in": "path", "required": true, "schema": { "type": "string" } }] }
    }
  }
}
